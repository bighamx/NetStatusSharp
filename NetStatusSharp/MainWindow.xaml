<Window x:Class="NetStatusSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetStatusSharp.ViewModels"
        Title="NetStatusSharp · 网络连接监视器"
        Width="1320" Height="800" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <vm:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <vm:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentDim}"
                            Margin="0,0,11,0">
                        <TextBlock Text="N" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="网络连接监视器" Style="{StaticResource TitleText}" />
                        <TextBlock Text="按进程查看本机 TCP / UDP 端点与连接状态"
                                   Foreground="{StaticResource FgMuted}" FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource Bg3}" Margin="12,0,0,0">
                        <TextBlock Text="IPv4 / IPv6" FontSize="10" Foreground="{StaticResource FgMuted}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="自动刷新 5 秒" IsChecked="{Binding AutoRefresh}"
                              ToolTip="每 5 秒按当前条件重新读取连接" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选区域 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,14,16,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="0.6*" />
                    <ColumnDefinition Width="0.55*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="进程名称" Style="{StaticResource LabelText}" />
                    <Grid>
                        <TextBox x:Name="ProcessNameBox" Style="{StaticResource TextInput}"
                                 Text="{Binding ProcessNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="FilterBox_KeyDown" ToolTip="名称包含匹配，不区分大小写" />
                        <TextBlock Text="名称包含…" Foreground="{StaticResource FgDim}" Margin="8,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ProcessNameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="PID" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource TextInput}" Text="{Binding ProcessIdFilter, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="FilterBox_KeyDown" ToolTip="多个 PID 用逗号分隔" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="本地端口" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource TextInput}" Text="{Binding LocalPortFilter, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="FilterBox_KeyDown" ToolTip="例如：80, 443" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0" IsEnabled="{Binding RemoteFiltersEnabled}">
                    <TextBlock Text="远程端口" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource TextInput}" Text="{Binding RemotePortFilter, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="FilterBox_KeyDown" ToolTip="仅适用于 TCP" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="协议" Style="{StaticResource LabelText}" />
                    <ComboBox Style="{StaticResource FlatCombo}" ItemsSource="{Binding ProtocolOptions}"
                              SelectedItem="{Binding SelectedProtocol}" />
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="IP 版本" Style="{StaticResource LabelText}" />
                    <ComboBox Style="{StaticResource FlatCombo}" ItemsSource="{Binding IpVersionOptions}"
                              SelectedItem="{Binding SelectedIpVersion}" />
                </StackPanel>

                <StackPanel Grid.Column="6" Margin="0,0,10,0" IsEnabled="{Binding RemoteFiltersEnabled}">
                    <TextBlock Text="TCP 状态" Style="{StaticResource LabelText}" />
                    <ComboBox Style="{StaticResource FlatCombo}" ItemsSource="{Binding StateOptions}"
                              SelectedItem="{Binding SelectedState}" />
                </StackPanel>

                <Button Grid.Column="7" Content="{Binding RefreshButtonText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshOrCancelCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        ToolTip="刷新连接；刷新期间可点击停止" />

                <Button Grid.Column="8" Content="清空" Style="{StaticResource FlatButton}"
                        Command="{Binding ClearCommand}" VerticalAlignment="Bottom" MinWidth="74"
                        ToolTip="清空筛选并刷新（Ctrl+L）" />
            </Grid>
        </Border>

        <!-- 摘要卡片 -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="16,12,16,12">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14,9">
                <Grid>
                    <TextBlock Text="当前连接" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount, StringFormat=N0}" Foreground="{StaticResource Fg}"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,9">
                <Grid>
                    <TextBlock Text="TCP" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TcpCount, StringFormat=N0}" Foreground="{StaticResource Accent}"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,9">
                <Grid>
                    <TextBlock Text="UDP" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UdpCount, StringFormat=N0}" Foreground="#A886FF"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14,9">
                <Grid>
                    <TextBlock Text="已建立" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EstablishedCount, StringFormat=N0}" Foreground="{StaticResource Success}"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- 连接表格 -->
        <Grid Grid.Row="3" Margin="16,0">
            <Border Style="{StaticResource Card}" ClipToBounds="True">
                <DataGrid x:Name="ConnectionGrid" Style="{StaticResource ConnectionGrid}"
                          ItemsSource="{Binding Rows}" FrozenColumnCount="3"
                          CopyingRowClipboardContent="ConnectionGrid_CopyingRowClipboardContent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="52"
                                           ElementStyle="{StaticResource GridNumber}" />
                        <DataGridTemplateColumn Header="" Width="42" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ProcessIcon}" Width="16" Height="16" Stretch="Uniform" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="*" MinWidth="160"
                                           ElementStyle="{StaticResource GridText}" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="82">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                    <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="协议" SortMemberPath="Protocol" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource Bg3}">
                                        <TextBlock Text="{Binding Protocol}" Foreground="{Binding ProtocolBrush}"
                                                   FontSize="10.5" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="IP" SortMemberPath="IpVersion" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource Bg3}">
                                        <TextBlock Text="{Binding IpVersion}" Foreground="{Binding IpVersionBrush}"
                                                   FontSize="10.5" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="本地端点" Binding="{Binding LocalEndpoint}" Width="1.45*"
                                           MinWidth="190" ElementStyle="{StaticResource GridEndpoint}" />
                        <DataGridTextColumn Header="远程端点" Binding="{Binding RemoteEndpoint}" Width="1.45*"
                                           MinWidth="190" ElementStyle="{StaticResource GridEndpoint}" />
                        <DataGridTemplateColumn Header="状态" SortMemberPath="State" Width="126">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVisibility}}"
                        IsHitTestVisible="False">
                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Bg3}"
                        HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="⌕" Foreground="{StaticResource FgMuted}" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="没有符合当前条件的连接" Foreground="{StaticResource FgMuted}"
                           FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="调整筛选条件后按 Enter 或 F5 刷新" Foreground="{StaticResource FgDim}"
                           FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="{StaticResource Bg0}" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="94" Height="3" IsIndeterminate="True" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgMuted}" FontSize="10.5" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="F5 刷新   ·   Enter 应用筛选   ·   Ctrl+C 复制"
                           Foreground="{StaticResource FgDim}" FontSize="10.5" />
            </Grid>
        </Border>
    </Grid>
</Window>
